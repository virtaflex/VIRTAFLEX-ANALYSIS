# ── Website build (read by Vite at build time) ──────────────────
# api | whatsapp | demo   (overrides site.ordering.mode in src/config/site.ts)
VITE_ORDER_MODE=demo
# Only if the API runs on a different domain than the website
# VITE_API_BASE_URL=https://orders.example.com/api

# ── Order server (npm start) ────────────────────────────────────
PORT=8080
# Public website address (used for Paymob redirects + webhooks)
PUBLIC_URL=https://pizzahub.example
# Long random string — protects /api/admin/*
ADMIN_TOKEN=
# Set to 1 behind a reverse proxy / load balancer
TRUST_PROXY=0
# If the website is hosted on another origin, list it here (comma-separated)
ALLOWED_ORIGINS=
# DATA_DIR=./data

# New-order notifications (any or all)
ORDER_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Paymob — Dashboard → Settings / Developers
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
# Card / wallet integration IDs, comma-separated
PAYMOB_INTEGRATION_IDS=
PAYMOB_HMAC_SECRET=
# PAYMOB_API_BASE=https://accept.paymob.com
# PAYMOB_BILLING_EMAIL=orders@pizzahub.example
